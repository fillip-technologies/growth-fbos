APP_ENV=development
HOST=0.0.0.0
PORT=8001
DEBUG=false
JWT_SECRET=fbos-local-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=mysql+aiomysql://root:fbos_root_password@db:3306/fbos_identity
DB_SSL=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Mail (SMTP)
MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS="you@example.com"
MAIL_FROM_NAME="FBOS"
