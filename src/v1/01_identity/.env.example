APP_ENV=development
HOST=0.0.0.0
PORT=8001
DEBUG=false
JWT_SECRET=fbos-local-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=mysql+aiomysql://root:fbos_root_password@db:3306/fbos_identity
DB_SSL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# Each connection raises its idle timeout to this (hosted MariaDB defaults to 20 s);
# the pool recycles connections a little before it.
DB_SESSION_WAIT_TIMEOUT=3600
DB_POOL_RECYCLE=3300
DB_POOL_PRE_PING=true

# Shared secret for service-to-service /internal/* calls (X-FBOS-Internal-Token)
INTERNAL_SERVICE_TOKEN=

# Mail (SMTP)
# Base URL of the client-admin frontend; all email links are built from it.
CLIENT_ADMIN_BASE_URL=http://localhost:5174
MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS="you@example.com"
MAIL_FROM_NAME="FBOS"
# Auth cache; leave empty to run without Redis (every check then reads the database).
# Every identity instance on the same database must use the same Redis.
REDIS_URL=redis://redis:6379/0
