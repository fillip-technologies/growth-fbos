APP_ENV=development
HOST=0.0.0.0
PORT=8010
DEBUG=false
JWT_SECRET=fbos-local-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=mysql+aiomysql://root:fbos_root_password@db:3306/fbos_people
# Encrypts ID and bank account numbers. Generate once and keep it: numbers saved with one key cannot be
# read with another.  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
DB_SSL=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

IDENTITY_SERVICE_URL=http://localhost:8001
# Must match identity's INTERNAL_SERVICE_TOKEN (identity skips the check in development when unset)
INTERNAL_SERVICE_TOKEN=
ASSETS_SERVICE_URL=http://localhost:8009
DOCUMENTS_SERVICE_URL=http://localhost:8005
COMMUNICATION_SERVICE_URL=http://localhost:8006
DELIVERY_SERVICE_URL=http://localhost:8003
CONTROL_SERVICE_URL=http://localhost:8004
MANAGEMENT_SERVICE_URL=http://localhost:8007
