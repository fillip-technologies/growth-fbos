APP_ENV=development
HOST=0.0.0.0
PORT=8002
DEBUG=false

# Identity authenticates every request (internal /authz/actor call)
IDENTITY_SERVICE_URL=http://identity:8000
# Must match identity's INTERNAL_SERVICE_TOKEN (identity skips the check in development when unset)
INTERNAL_SERVICE_TOKEN=
# Documents stores files attached to quotations and contracts (it calls back
# /internal/subject-access to check who may see or attach them)
DOCUMENTS_SERVICE_URL=http://documents:8000

# In-app notifications go to the communication service (empty: none are sent).
COMMUNICATION_SERVICE_URL=http://communication:8000

# Website enquiries (filliptechnologies.com) -> leads. The key alone sends lead status changes
# back to the website. Importing also needs the organization, the owner of imported leads and an
# interval above 0. Set the interval ONLY on the live server: every environment shares the
# database, and two importers would duplicate leads.
WEBSITE_LEADS_API_KEY=
WEBSITE_LEADS_ORGANIZATION_ID=
WEBSITE_LEADS_OWNER_USER_ID=
WEBSITE_LEADS_IMPORT_INTERVAL_SECONDS=0

DATABASE_URL=mysql+aiomysql://root:fbos_root_password@db:3306/fbos_revenue
DB_SSL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# Each connection raises its idle timeout to this (hosted MariaDB defaults to 20 s);
# the pool recycles connections a little before it.
DB_SESSION_WAIT_TIMEOUT=3600
DB_POOL_RECYCLE=3300
DB_POOL_PRE_PING=true
