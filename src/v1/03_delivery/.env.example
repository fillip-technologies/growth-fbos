APP_ENV=development
HOST=0.0.0.0
PORT=8003
DEBUG=false

# Identity authenticates every request (internal /authz/actor call)
IDENTITY_SERVICE_URL=http://identity:8000
# Must match identity's INTERNAL_SERVICE_TOKEN (identity skips the check in development when unset)
INTERNAL_SERVICE_TOKEN=

# Task notifications wait in the outbox; the worker sends them to communication. Keep it off (0)
# outside the live server: every environment shares the database, so one worker sends for all.
COMMUNICATION_SERVICE_URL=
# Finished sales tasks logged on revenue's timelines (the revenue_activities setting) go here.
REVENUE_SERVICE_URL=
WORKER_INTERVAL_SECONDS=0

DATABASE_URL=mysql+aiomysql://root:fbos_root_password@db:3306/fbos_delivery
DB_SSL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# Each connection raises its idle timeout to this (hosted MariaDB defaults to 20 s);
# the pool recycles connections a little before it.
DB_SESSION_WAIT_TIMEOUT=3600
DB_POOL_RECYCLE=3300
DB_POOL_PRE_PING=true
