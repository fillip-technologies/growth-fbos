APP_ENV=development
HOST=0.0.0.0
PORT=8007
DEBUG=false

DATABASE_URL=mysql+aiomysql://root:fbos_root_password@db:3306/fbos_management
DB_SSL=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Every request is authenticated by identity (its /internal/authz/actor).
IDENTITY_SERVICE_URL=http://identity:8000
# Must match identity's INTERNAL_SERVICE_TOKEN (identity skips the check in development when unset)
INTERNAL_SERVICE_TOKEN=
IDENTITY_TIMEOUT_SECONDS=5

# KPI targets and budgets are approved through control's approval requests.
CONTROL_SERVICE_URL=http://control:8000

# Approved absences (people) and recorded effort (delivery) for the capacity ledger and utilization.
PEOPLE_SERVICE_URL=http://people:8000
DELIVERY_SERVICE_URL=http://delivery:8000
REVENUE_SERVICE_URL=http://revenue:8000

# Rebuilds the capacity ledger in the background. Turn on for ONE server only.
CAPACITY_WORKER_ENABLED=false
CAPACITY_WORKER_INTERVAL_SECONDS=3600

# Mirrors Revenue's issued documents (net of tax) into each budget's "revenue" line. Turn on for ONE server only.
REVENUE_PULL_ENABLED=false
REVENUE_PULL_INTERVAL_SECONDS=86400
