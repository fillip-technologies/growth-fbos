APP_ENV=development
HOST=0.0.0.0
PORT=8005
DEBUG=false
# Identity authenticates every request (internal /authz/actor call)
IDENTITY_SERVICE_URL=http://identity:8000
# Must match identity's INTERNAL_SERVICE_TOKEN (identity skips the check in development when unset)
INTERNAL_SERVICE_TOKEN=

# Services that own the records documents attach to (subject type prefix -> API base).
# Each answers GET <base>/internal/subject-access/{type}/{id}?action=read|attach
SUBJECT_SERVICES={"revenue": "http://revenue:8000/api/revenue/v1", "delivery": "http://delivery:8000/api/delivery/v1", "inventory": "http://host.docker.internal:3000/api/inventory/v1"}

DATABASE_URL=mysql+aiomysql://root:fbos_root_password@db:3306/fbos_documents
DB_SSL=false
# The database user is shared by every service, so pools stay small.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# The hosted MariaDB drops connections idle for 20 s; each connection raises its own idle
# timeout to DB_SESSION_WAIT_TIMEOUT, and the pool retires them before that (recycle < wait).
DB_SESSION_WAIT_TIMEOUT=3600
DB_POOL_RECYCLE=3300
DB_POOL_PRE_PING=true

# ImageKit.io file storage (empty private key = local stub mode, no real uploads)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=fbos-documents

# No virus scanner yet: uploads are marked not_scanned and downloadable. Turn on once a
# scanner marks files clean, or downloads will wait on "pending" forever.
VIRUS_SCAN_ENABLED=false
