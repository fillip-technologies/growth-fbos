APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=false
JWT_SECRET=fbos-local-secret-key-change-in-production
JWT_ALGORITHM=HS256

IDENTITY_SERVICE_URL=http://identity:8000
REVENUE_SERVICE_URL=http://revenue:8000
DELIVERY_SERVICE_URL=http://delivery:8000
CONTROL_SERVICE_URL=http://control:8000
DOCUMENTS_SERVICE_URL=http://documents:8000
COMMUNICATION_SERVICE_URL=http://communication:8000
MANAGEMENT_SERVICE_URL=http://management:8000
INSIGHT_SERVICE_URL=http://insight:8000
ASSETS_SERVICE_URL=http://assets:8000
FINANCE_SERVICE_URL=http://finance:8000
# The Fixly backend on the host (docker-compose.dev.yml maps host.docker.internal)
INVENTORY_SERVICE_URL=http://host.docker.internal:3000

AGGREGATION_TIMEOUT_SECONDS=0.8

# Must match identity's INTERNAL_SERVICE_TOKEN (identity skips the check in development when unset)
INTERNAL_SERVICE_TOKEN=
IDENTITY_TIMEOUT_SECONDS=5
# CEO Command Center: per summary call, how many calls at once, and the org Fixly serves
CEO_TIMEOUT_SECONDS=5
CEO_MAX_PARALLEL_CALLS=20
INVENTORY_ORGANIZATION_ID=
