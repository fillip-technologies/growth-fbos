# Root .env for docker-compose MySQL service only.
# Each microservice reads its own .env file in src/v1/<service>/.env
# These defaults already match every service's DATABASE_URL, so `cp .env.docker.example .env`
# is enough to run `docker compose up` locally — change them only for a non-local environment.

# MySQL container credentials
MYSQL_ROOT_PASSWORD=fbos_root_password
MYSQL_DATABASE=fbos
MYSQL_USER=fbos_user
MYSQL_PASSWORD=fbos_password
