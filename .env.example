APP_ENV=development
HOST=0.0.0.0
DEBUG=false

# Identity Service
PORT=8000
JWT_SECRET=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database — mysql+aiomysql:// scheme required for the async driver
DATABASE_URL=mysql+aiomysql://user:password@host:3306/dbname
DB_SSL=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Commercial Service
# PORT=8001

# Billing Service
# PORT=8002

# Work Service
# PORT=8003

# Workflow Service
# PORT=8004

# Task Service
# PORT=8005

# Approval Service
# PORT=8006

# Document, Notification & Audit Service
# PORT=8007

# Resource, Planning & Performance Service
# PORT=8008


