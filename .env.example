APP_ENV=development
HOST=0.0.0.0
DEBUG=false

# Identity Service
PORT=8001
JWT_SECRET=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database — mysql+aiomysql:// scheme required for the async driver
DATABASE_URL=mysql+aiomysql://user:password@host:3306/dbname
DB_SSL=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Gateway Service (routing, aggregated screens — no database)
# PORT=8000

# Revenue Service (Commercial/CRM & Billing)
# PORT=8002

# Delivery Service (Work units, Workflow, Tasks)
# PORT=8003

# Control Service (Approvals, SLA)
# PORT=8004

# Documents Service
# PORT=8005

# Communication Service (Notifications, inbox, webhooks)
# PORT=8006

# Management Service (Planning, Performance/KPIs, Resources)
# PORT=8007

# Insight Service (Audit, Analytics)
# PORT=8008

# Assets Service
# PORT=8009



